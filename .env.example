# MCP Verify local environment example
#
# Copy this file to .env or .env.local only when you use an optional LLM
# provider. Do not commit the copied file. The CLI works without provider keys.
#
# Keep one provider key only when you intend to use that provider.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional CLI language. English is the default; Spanish is the maintained
# secondary language.
# MCP_VERIFY_LANG=en

# Optional process-level configuration. Prefer a project configuration file for
# durable settings; use environment variables for local or CI overrides.
# MCP_VERIFY_TIMEOUT=5000
# MCP_VERIFY_FAIL_ON_CRITICAL=true
