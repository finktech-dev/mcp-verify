{
  "name": "@finktech/mcp-verify",
  "version": "1.0.2",
  "private": false,
  "description": "Security validation and testing tools for Model Context Protocol servers",
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "overrides": {
    "fast-uri": ">=3.1.2",
    "hono": ">=4.12.23"
  },
  "main": "dist/mcp-verify.js",
  "bin": {
    "mcp-verify": "dist/mcp-verify.js"
  },
  "files": [
    "dist/mcp-verify.js",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "QUICKSTART.md",
    "RESPONSIBLE_USAGE.md",
    "SECURITY_TESTING.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "COMMANDS.md",
    "docs/DEFERRED_CLI_COMMANDS.md",
    "docs/REMOVED_SURFACES.md",
    "TESTING.md",
    "TROUBLESHOOTING.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "ajv-i18n": "^4.2.0",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "eventsource": "^2.0.2",
    "inquirer": "^13.3.0",
    "ora": "^7.0.0",
    "shell-quote": "^1.8.3",
    "update-notifier": "^7.3.1",
    "zod": "^4.3.6"
  },
  "scripts": {
    "dev": "ts-node apps/cli-verifier/src/bin/index.ts",
    "start": "node dist/mcp-verify.js",
    "clean": "node tools/scripts/clean-dist.js",
    "build": "npm run clean && tsc --emitDeclarationOnly --outDir dist --project tsconfig.build.json && node tools/scripts/bundle.js",
    "compile": "node tools/scripts/compile-sea.js",
    "compile:all": "node tools/scripts/compile-sea.js --all",
    "compile:linux": "node tools/scripts/compile-sea.js --target linux",
    "compile:macos": "node tools/scripts/compile-sea.js --target macos",
    "compile:win": "node tools/scripts/compile-sea.js --target windows",
    "postcompile": "node tools/scripts/copy-native-addons.js",
    "type-check": "tsc --noEmit --project tsconfig.build.json",
    "type-check:strict": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.js --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.unit.config.js",
    "test:security": "jest --config jest.security.config.js",
    "test:scenario": "jest --config jest.scenario.config.js",
    "test:integration": "npm run test:scenario",
    "test:release-smoke": "node dist/mcp-verify.js --version && node dist/mcp-verify.js --help",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "test:all": "npm run test:unit && npm run test:security && npm run test:scenario",
    "test:watch": "jest --config jest.unit.config.js --watch",
    "test:coverage": "npm run test:unit -- --coverage",
    "test:ci": "npm run test:unit -- --ci --coverage",
    "preview:report": "ts-node tools/scripts/generate-report-preview.ts",
    "prepublishOnly": "npm run type-check && npm run lint && npm run test:unit && npm run test:security && npm run test:scenario && npm run build && npm run test:release-smoke && npm run pack:check",
    "setup-hooks": "husky install"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "security",
    "security-audit",
    "security-testing",
    "vulnerability-scanner",
    "validation",
    "testing",
    "fuzzing",
    "penetration-testing",
    "json-rpc",
    "cli",
    "ai",
    "llm",
    "claude",
    "anthropic",
    "owasp",
    "owasp-top-10",
    "devsecops",
    "appsec"
  ],
  "author": {
    "name": "Ariel Fink",
    "email": "hello.finksystems@gmail.com",
    "url": "https://github.com/FinkTech"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FinkTech/mcp-verify.git"
  },
  "bugs": {
    "url": "https://github.com/FinkTech/mcp-verify/issues"
  },
  "homepage": "https://github.com/FinkTech/mcp-verify#readme",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/update-notifier": "^6.0.8",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "esbuild": "^0.28.2",
    "esbuild-plugin-tsconfig-paths": "^1.0.2",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-security": "^1.7.1",
    "husky": "^8.0.3",
    "jest": "^29.0.0",
    "lint-staged": "^15.0.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "openai": "^6.17.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  }
}
